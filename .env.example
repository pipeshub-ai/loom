# Copy to .env and fill in what you need. .env is gitignored; this file is not,
# so never put a real secret here.
#
# Nothing is required to run the test suite or the offline cookbook examples —
# these are only for examples and toolsets that talk to a real service.

# --- Model providers -------------------------------------------------------
# Any one of these is enough; the examples default to Anthropic.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# --- Google: Gmail and Calendar --------------------------------------------
# NOT an API key. Gmail rejects API keys outright and Calendar accepts them
# only for public calendars, because a key identifies a project rather than a
# person. You need an OAuth client ID (Desktop app) from
# console.cloud.google.com -> APIs & Services -> Credentials.
#
# Get the refresh token with:
#   python -m workflow_builder.toolsets.google.setup \
#       --client-id ... --client-secret ... --scopes read
#
# Heads-up: while the OAuth consent screen is in "Testing" status, Google
# expires the refresh token after 7 days.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REFRESH_TOKEN=1//...

# Alternative to the three above: a ready-made token, e.g. from the OAuth
# Playground. Valid for one hour. Takes precedence if set, so do not leave a
# stale one here alongside the refresh token.
# GOOGLE_ACCESS_TOKEN=ya29....

# Alternative for Google Workspace domain-wide delegation. Needs the extra:
#   pip install 'workflow-builder[google]'
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# GOOGLE_IMPERSONATE_SUBJECT=user@yourdomain.com

# --- Atlassian -------------------------------------------------------------
JIRA_URL=https://yourorg.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=...

CONFLUENCE_URL=https://yourorg.atlassian.net/wiki
CONFLUENCE_EMAIL=you@example.com
CONFLUENCE_API_TOKEN=...

# --- Runtime ---------------------------------------------------------------
# Where the journal lives. Workflows never choose this; the host does.
# memory:// (default) | sqlite:///runs.db | postgres://... | mongodb://...
# LOOM_STORE=sqlite:///runs.db
