# LOOM — environment template
# ===========================
#
# Copy to `.env` and uncomment what you need. `.env` is gitignored; this file
# is not, so never put a real secret here. Every line below is commented out on
# purpose: an unset variable is a clean "not configured", while a placeholder
# value is a credential that fails at the first API call with a 401 that reads
# like a broken toolset.
#
# HOW THIS FILE IS READ
#   LOOM does not auto-load `.env` — the CLI, the server and the SDK read the
#   process environment. Two deliberate exceptions:
#     * `loom login` / `loom connect` read LOOM_OAUTH_REDIRECT_PORT from a
#       `.env` in the current directory (see `resolve_redirect_port`).
#     * the cookbook examples call `examples/cookbook/utils.py::load_dotenv`,
#       which loads `.env` from the repo root.
#   For everything else, export it (`set -a; . ./.env; set +a`), use `direnv`,
#   or hand it to your process manager / container.
#
#   In all cases a real environment variable wins over the file.
#
# NOTHING HERE IS REQUIRED. `pytest`, `loom run`, and the offline cookbook
# examples work with no variable set at all: the store defaults to memory://
# and every toolset is optional.
#
# CREDENTIALS DO NOT HAVE TO LIVE HERE. `loom connect <provider>` stores an
# OAuth credential encrypted under ~/.loom, refreshes it in the background, and
# `loom whoami` reports its health. Env vars are the CI/container path; the
# credential store is the laptop path. A run's credential store is consulted
# before these variables by every toolset that supports it.


# ===========================================================================
# 1. Runtime — where state lives
# ===========================================================================

# Where the journal lives. Workflows never choose this; the host does, so the
# same workflow code runs against all four.
#   memory:// (default)  in-process, gone when the process exits
#   sqlite:///runs.db    a laptop, a single container
#   postgres://user:pass@host:5432/loom     needs loomsdk[postgres]
#   mongodb://host:27017/loom               needs loomsdk[mongo]
# LOOM_STORE=sqlite:///runs.db

# Where blob content lives (artifacts, attachments, offloaded journal
# payloads). Unset means no blob service: large payloads stay inline and
# `RetentionManager.compact(store, blobs=...)` has nothing to reclaim.
#   file:///var/loom/blobs      s3://bucket/prefix   (extra: s3)
#   az://container/prefix       gs://bucket/prefix   (extras: azure, gcs)
# LOOM_BLOBS=file://./.loom-blobs

# Only for `file://` blobs that must mint signed download URLs
# (`ctx.artifact_url`). Without both, LocalBlobBackend.signed_url() raises
# rather than handing out an unsigned link.
# LOOM_BLOBS_BASE_URL=http://localhost:8000
# LOOM_BLOBS_SIGNING_SECRET=change-me

# Cloud blob backends authenticate through their own SDKs, not through LOOM:
#   s3://    aioboto3 → AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION
#            (or an instance role, or AWS_PROFILE)
#   az://    AZURE_STORAGE_CONNECTION_STRING
#   gs://    GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AZURE_STORAGE_CONNECTION_STRING=
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json


# ===========================================================================
# 2. Credentials the CLI stores
# ===========================================================================

# Directory for LOOM's own state — the encrypted credential file lives at
# $LOOM_HOME/credentials.enc. Defaults to ~/.loom.
# LOOM_HOME=/var/lib/loom

# The key that encrypts that file, base64. This is the portable option and the
# one CI and containers want: with it set, LOOM skips the OS keyring and skips
# generating a machine-local key — a key that, once lost, makes every stored
# credential unreadable. Resolution order is LOOM_CREDENTIAL_KEY → OS keyring →
# a generated file under $LOOM_HOME (with a loud warning).
# LOOM_CREDENTIAL_KEY=

# How early an OAuth token is renewed, in seconds before expiry. Default 600.
# This is when renewal is *attempted*, not when failing to renew becomes an
# error — the gap is what absorbs clock drift against the authorization server.
# Clamped to half the token's own lifetime, so a short-lived token is not
# reported as due the moment it is minted.
# LOOM_OAUTH_REFRESH_SKEW=600

# Loopback port `loom login` / `loom connect` bind for the PKCE redirect.
# Default 8931 — register http://127.0.0.1:8931/callback on the OAuth client.
# Set this only if that port is taken; a busy default is an error, not a silent
# hop to another port (which would miss the registered redirect URI).
# LOOM_OAUTH_REDIRECT_PORT=8931

# Force the device-code flow instead of opening a browser. Auto-detected on
# Linux from DISPLAY/WAYLAND_DISPLAY; set this over SSH, in a container, or
# anywhere the detection guesses wrong. Accepts 1/true/yes.
# LOOM_LOGIN_HEADLESS=1


# ===========================================================================
# 3. `loom connect` for a provider LOOM does not ship
# ===========================================================================
#
# Built-in providers need none of this — `loom connect google|google_gmail|
# google_calendar|atlassian|github|slack|zoom` knows their endpoints and only
# wants a client id (`loom providers` lists them).
#
# For anything else, every `loom connect <name>` flag has an env fallback under
# LOOM_CONNECT_<NAME>_*, with <NAME> upper-cased and non-alphanumerics turned
# into underscores (`loom connect my-service` → LOOM_CONNECT_MY_SERVICE_*).
# `loom login` reads the same suffixes under LOOM_LOGIN_*.
#
# LOOM_CONNECT_MYSERVICE_AUTHORIZATION_ENDPOINT=https://example.com/oauth/authorize
# LOOM_CONNECT_MYSERVICE_TOKEN_ENDPOINT=https://example.com/oauth/token
# LOOM_CONNECT_MYSERVICE_DEVICE_AUTHORIZATION_ENDPOINT=https://example.com/oauth/device
# LOOM_CONNECT_MYSERVICE_CLIENT_ID=
# LOOM_CONNECT_MYSERVICE_CLIENT_SECRET=
# LOOM_CONNECT_MYSERVICE_SCOPES=read write        # space-separated

# ConnectionBroker's default resolver (EnvCredentialResolver) reads a bearer
# token per connection id: LOOM_CONN_<ID>_TOKEN, or _KEY.
# LOOM_CONN_GITHUB_TOKEN=
# LOOM_CONN_SLACK_TOKEN=


# ===========================================================================
# 4. Serving — `loom serve` and `loom mcp`
# ===========================================================================
#
# Set none of these and both commands behave exactly as they did before
# identity existed: no token verification, and a refusal to bind to anything
# but loopback. Set one verifier — jwks_uri, introspection_endpoint, or
# static_tokens_file — and every request is authenticated.

# Required by both the JWKS and introspection verifiers. RESOURCE is this
# server's own externally reachable URL, checked as the token's audience —
# it is what stops a token minted for another resource server being replayed
# here (RFC 8707).
# LOOM_AUTH_ISSUER=https://auth.example.com
# LOOM_AUTH_RESOURCE=https://loom.example.com

# (a) JWKS — verify RS/ES-signed tokens locally, no round trip per request.
# LOOM_AUTH_JWKS_URI=https://auth.example.com/.well-known/jwks.json
# LOOM_AUTH_ALGORITHMS=["RS256","ES256"]     # list values are JSON
# LOOM_AUTH_LEEWAY_SECONDS=60
# LOOM_AUTH_REQUIRED_SCOPES=["loom.run"]

# (b) Introspection (RFC 7662) — for opaque tokens a JWKS cannot verify.
# All three are needed together.
# LOOM_AUTH_INTROSPECTION_ENDPOINT=https://auth.example.com/introspect
# LOOM_AUTH_INTROSPECTION_CLIENT_ID=
# LOOM_AUTH_INTROSPECTION_CLIENT_SECRET=

# (c) Static tokens — a JSON file of
#     {"<token>": {"subject": ..., "scopes": [...], "client_id": ...}}
# For self-hosted installs and tests only: the tokens sit in that file in
# cleartext, with no expiry and no revocation short of deleting the line.
# LOOM_AUTH_STATIC_TOKENS_FILE=/etc/loom/tokens.json

# Transport hardening for the HTTP/SSE surfaces.
# LOOM_AUTH_DNS_REBINDING_PROTECTION=true
# LOOM_AUTH_ALLOWED_HOSTS=["loom.example.com"]
# LOOM_AUTH_ALLOWED_ORIGINS=["https://app.example.com"]

# MCP authoring tools (validate_workflow_code, smoke_test_workflow,
# save_workflow, …). Enabled by default; 0/false/no exposes only the
# run-management surface.
# LOOM_MCP_AUTHORING=1
# LOOM_MCP_SMOKE_TIMEOUT=30
# LOOM_MCP_MAX_CODE_SIZE=64000


# ===========================================================================
# 5. Model providers
# ===========================================================================
# Any one is enough; the examples default to Anthropic.

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=                # GOOGLE_API_KEY is read as a fallback

# OpenAI-compatible endpoints (Azure, Together, Groq, vLLM, Ollama).
# OPENAI_BASE_URL=http://localhost:11434/v1


# ===========================================================================
# 6. Google Workspace — gmail, google_calendar, google_drive, google_meet
# ===========================================================================
#
# NOT an API key. Gmail rejects API keys outright and Calendar accepts them
# only for public calendars, because a key identifies a project rather than a
# person. You need an OAuth client (Desktop app) from
# console.cloud.google.com → APIs & Services → Credentials.
#
# Mint the refresh token with:
#   python -m loom.toolsets.google.setup --client-id ... --client-secret ... \
#       --scopes read
# (`--scopes drive`, `write`, or a bare scope URL also work.)
#
# Heads-up: while the OAuth consent screen is in "Testing" status, Google
# expires the refresh token after 7 days.
#
# The refresh trio WINS over GOOGLE_ACCESS_TOKEN when both are set — an access
# token lives an hour, a refresh token mints fresh ones indefinitely, and a
# workflow that sleeps outlives the access token by design.
# GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REFRESH_TOKEN=1//...

# A ready-made token, e.g. from the OAuth Playground. Valid for one hour.
# GOOGLE_ACCESS_TOKEN=

# Workspace domain-wide delegation, to act as any user in a domain. Signing a
# JWT needs a crypto library, so this shape — and only this one — needs
# `pip install 'loomsdk[google]'`.
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# GOOGLE_IMPERSONATE_SUBJECT=user@yourdomain.com


# ===========================================================================
# 7. Microsoft Graph — onedrive, sharepoint, teams, onenote, outlook_*
# ===========================================================================
#
# Three modes, tried in this order. AZURE_TENANT_ID / AZURE_CLIENT_ID /
# AZURE_CLIENT_SECRET are accepted as fallbacks for the first three, since
# that is the trio the Azure SDKs already put in an environment.
#
# (a) Delegated — the workflow acts as a person, so /me works. All four:
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_REFRESH_TOKEN=
#
# (b) Client credentials — the workflow acts as the application. The first
#     three only. /me does not exist here, so the clients refuse a /me path up
#     front and name the per-toolset user variable below.
#
# (c) A token someone else minted:
# MS_GRAPH_ACCESS_TOKEN=

# Who or what to act on under client credentials (a UPN or an object id).
# MS_ONEDRIVE_USER=user@yourdomain.com
# MS_ONEDRIVE_DRIVE_ID=                  # addresses a drive without a user
# MS_SHAREPOINT_SITE=yourorg.sharepoint.com:/sites/Engineering
# MS_TEAMS_USER=user@yourdomain.com
# MS_ONENOTE_USER=user@yourdomain.com
# MS_ONENOTE_SITE=                       # a site- or group-scoped notebook
# MS_ONENOTE_GROUP=                      # bypasses the /me refusal
# MS_OUTLOOK_USER=user@yourdomain.com
# MS_OUTLOOK_TIMEZONE=Europe/London      # sent as `Prefer: outlook.timezone`

# National clouds (US Gov, 21Vianet) differ in both hosts.
# MS_AUTHORITY_HOST=https://login.microsoftonline.com
# MS_GRAPH_BASE_URL=https://graph.microsoft.com/v1.0


# ===========================================================================
# 8. Atlassian — jira, confluence
# ===========================================================================
# An API token from id.atlassian.com → Security → API tokens, paired with the
# account email. `loom connect atlassian` is the OAuth alternative.
# JIRA_URL=https://yourorg.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=

# CONFLUENCE_URL=https://yourorg.atlassian.net/wiki
# CONFLUENCE_EMAIL=you@example.com
# CONFLUENCE_API_TOKEN=


# ===========================================================================
# 9. Slack and Zoom
# ===========================================================================

# A bot token (xoxb-…). SLACK_TOKEN is read as a fallback.
# `loom connect slack` stores one instead.
# SLACK_BOT_TOKEN=xoxb-...

# Zoom's default is Server-to-Server OAuth, which has no refresh token: these
# three ARE the durable credential and an hourly token is minted from them on
# demand. `loom connect zoom` covers the user-delegated case instead.
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_ACCESS_TOKEN=                     # or a ready-made token, ~1 hour


# ===========================================================================
# 10. Code hosting — github, gitlab
# ===========================================================================

# A classic or fine-grained personal access token.
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com  # GitHub Enterprise Server

# A personal, project, or group access token — or an OAuth token. GitLab is
# self-managed as often as not, so the host is configuration.
# GITLAB_TOKEN=
# GITLAB_OAUTH_TOKEN=
# GITLAB_URL=https://gitlab.com


# ===========================================================================
# 11. CRM — salesforce, hubspot
# ===========================================================================

# Salesforce has no constant base URL: every org answers on its own host,
# returned by the OAuth exchange as instance_url. The client refuses to
# construct without either an explicit instance URL or the refresh trio that
# produces one.
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_REFRESH_TOKEN=
# SALESFORCE_ACCESS_TOKEN=               # needs SALESFORCE_INSTANCE_URL too
# SALESFORCE_INSTANCE_URL=https://yourorg.my.salesforce.com
# Sandboxes authenticate elsewhere; a sandbox token against the production
# host fails as `invalid_grant`, which reads like a bad token rather than a
# wrong host.
# SALESFORCE_LOGIN_URL=https://test.salesforce.com

# A private app token, or an OAuth access token — both are plain bearers.
# HUBSPOT_ACCESS_TOKEN=


# ===========================================================================
# 12. Project management — clickup, asana
# ===========================================================================

# ClickUp sends these two DIFFERENTLY: a personal token goes in Authorization
# raw, an OAuth token takes the `Bearer` prefix. Sending a personal token as
# `Bearer pk_…` returns 401 with no hint why. OAUTH wins when both are set.
# CLICKUP_API_TOKEN=pk_...
# CLICKUP_OAUTH_TOKEN=

# A personal access token or an OAuth access token; one bearer shape.
# ASANA_ACCESS_TOKEN=


# ===========================================================================
# 13. Web search — exa, tavily, duckduckgo
# ===========================================================================

# EXA_API_KEY=                           # sent as x-api-key
# TAVILY_API_KEY=tvly-...                # sent as a bearer

# duckduckgo needs no credential — `pip install 'loomsdk[duckduckgo]'`.
# DDGS_PROXY is honoured by the `ddgs` package itself.
# DDGS_PROXY=


# ===========================================================================
# 14. Inbound webhooks — event sources
# ===========================================================================
# Only for a process serving `/hooks/<source>`. Verification is mandatory by
# default: a source constructed without its secret refuses deliveries rather
# than accepting unsigned ones.

# App credentials → Basic Information → Signing Secret. NOT the bot token;
# using the token here fails every signature with no indication why.
# SLACK_SIGNING_SECRET=

# The `secret` given when the webhook was registered via /rest/api/3/webhook.
# A webhook created in the Jira admin UI has none — that case needs
# JiraSource(require_signature=False), said out loud in code.
# JIRA_WEBHOOK_SECRET=

# Gmail push arrives via Pub/Sub, so what is verified is the OIDC token on the
# delivery. AUDIENCE is the `audience` configured on the push subscription.
# GMAIL_PUSH_AUDIENCE=https://loom.example.com/hooks/gmail
# GMAIL_PUSH_SERVICE_ACCOUNT=pubsub@yourproject.iam.gserviceaccount.com


# ===========================================================================
# 15. Contributors only — the test suite
# ===========================================================================
# Read by tests, never by the library. A backend that cannot be reached is
# SKIPPED and named, never silently dropped.
#
# LOOM_TEST_STORES=memory,sqlite         # narrow the conformance matrix
# LOOM_TEST_POSTGRES=postgresql://loom:loom@localhost:5432/loom_test
# LOOM_TEST_MONGO=mongodb://localhost:27017
# LOOM_TEST_S3_URL=s3://loom-test/prefix
# LOOM_TEST_AZURE_URL=az://loom-test/prefix
# LOOM_TEST_GCS_URL=gs://loom-test/prefix
